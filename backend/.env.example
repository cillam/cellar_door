# Required env vars for backend/. Copy to `.env` and fill in real values;
# `.env` is gitignored. See CLAUDE.md's "Never commit secrets" convention.
#
# app/config.py loads this file from backend/.env by default. If your
# real secrets live elsewhere (a separate directory outside the repo),
# set CELLAR_DOOR_ENV_FILE to that path instead of relying on the default.

# "local" or "production" -- see app/config.py. Defaults to "local" if
# unset, so nothing accidentally behaves like production by omission.
ENVIRONMENT=local

# Two connection strings against the same Postgres instance. Locally
# they're typically identical; against real Supabase they're different
# poolers -- see app/config.py and backend/alembic/env.py.
#
# Session pooler (port 5432) -- used by Alembic for migrations.
DATABASE_URL_MIGRATIONS=postgresql://postgres:postgres@localhost:5432/cellar_door
# Transaction pooler (port 6543) -- used by app/db.py's asyncpg pool.
DATABASE_URL_RUNTIME=postgresql://postgres:postgres@localhost:5432/cellar_door

# Anthropic API key, used by app/providers/claude.py (ClaudeProvider).
# https://console.anthropic.com/
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Supabase project config.
SUPABASE_URL=https://your-project.supabase.co
# Secret key (bypasses RLS) -- used by app/storage.py (SupabaseStorageClient).
# Never expose this to a client. Supabase's dashboard: Settings > API.
SUPABASE_SECRET_KEY=your-supabase-secret-key-here
# JWKS URL -- used by app/auth.py for signature verification.
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
