# Required env vars for backend/. Copy to `.env` and fill in real values;
# `.env` is gitignored. See CLAUDE.md's "Never commit secrets" convention.
#
# app/config.py loads this file from backend/.env by default. If your
# real secrets live elsewhere (a separate directory outside the repo),
# set ENV_FILE to that path instead of relying on the default.

# "local" or "production" -- see app/config.py. Defaults to "local" if
# unset, so nothing accidentally behaves like production by omission.
ENVIRONMENT=local

# Postgres connection string used by app/db.py (asyncpg) and Alembic
# (via a sync driver, see backend/alembic/env.py). Local Postgres today;
# swap for the real Supabase connection string in step 5 -- same
# variable, same code path either way.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cellar_door

# Anthropic API key, used by app/providers/claude.py (ClaudeProvider).
# https://console.anthropic.com/
ANTHROPIC_API_KEY=your-anthropic-api-key-here
