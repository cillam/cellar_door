# Required env vars for mobile/. Copy to `.env` and fill in real values;
# `.env` is gitignored. See CLAUDE.md's "Never commit secrets" convention.
#
# app.config.ts loads this file from mobile/.env by default. If your real
# secrets live elsewhere (a separate directory outside the repo, matching
# backend's CELLAR_DOOR_ENV_FILE pattern), set CELLAR_DOOR_MOBILE_ENV_FILE
# to that path instead of relying on the default. For EAS builds, set the
# same values via `eas secret:create` instead of a file.
#
# All three must be prefixed EXPO_PUBLIC_ -- that's what tells Metro to
# inline them into the client bundle. Only ever put values here that are
# safe to ship to a device (the Supabase key below is the publishable key,
# not the secret key -- see backend/.env.example for the backend-only one).

# Railway domain the app talks to for the FastAPI backend.
EXPO_PUBLIC_BACKEND_URL=https://your-backend.up.railway.app

# Supabase project URL -- same value as the backend's SUPABASE_URL.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase's publishable key (sb_publishable_...), safe for client-side use.
# NOT the secret key -- that one is backend-only. Supabase dashboard: Settings > API.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key-here
